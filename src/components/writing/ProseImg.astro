---
import { getImage, Image, type LocalImageProps } from "astro:assets";

interface Props {
	src: LocalImageProps["src"];
	darkSrc?: LocalImageProps["src"];
	alt?: string;
}

const { src, darkSrc, alt = "" } = Astro.props;
const darkImage = darkSrc ? await getImage({ src: darkSrc, alt }) : undefined;
---

<figure>
	{
		darkImage ? (
			<picture>
				<source
					data-scheme-dark
					srcset={darkImage.src}
					media="(prefers-color-scheme: dark)"
					width={darkImage.attributes.width}
					height={darkImage.attributes.height}
				/>
				<Image src={src} alt={alt} />
			</picture>
		) : (
			<Image src={src} alt={alt} />
		)
	}
	{
		Astro.slots.has("default") && (
			<figcaption>
				<slot />
			</figcaption>
		)
	}
</figure>

<style>
	img {
		border-radius: var(--t-radius-medium);
	}
</style>
