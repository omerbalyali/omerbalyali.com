---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
	src: ImageMetadata;
	darkSrc?: ImageMetadata;
	alt?: string;
}

const { src, darkSrc, alt = "" } = Astro.props;
---

<figure>
	{
		darkSrc ? (
			<picture>
				<source srcset={darkSrc.src} media="(prefers-color-scheme: dark)" />
				<Image src={src} alt={alt} />
			</picture>
		) : (
			<Image src={src} alt={alt} />
		)
	}
	{
		Astro.slots.has("default") && (
			<figcaption>
				<slot />
			</figcaption>
		)
	}
</figure>

<style>
	img {
		border-radius: var(--t-radius-medium);
	}
</style>
