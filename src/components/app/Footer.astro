---

<footer class="app-container-padded">
	<p>&copy; 2026</p>
	<nav aria-label="Legal links" class="legal-nav">
		<ul>
			<li>
				<a href="/legal-notice/">Legal Notice</a>
			</li>
			<li>
				<a href="/privacy-policy/">Privacy Policy</a>
			</li>
			<li>
				<a href="/rss.xml" data-icon="rss">RSS</a>
			</li>
		</ul>
	</nav>
</footer>

<style>
	footer {
		position: sticky;
		inset-inline: 0;
		inset-block-end: 0;
		z-index: 0;
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding-block: var(--t-space-12) var(--t-space-27);
		font-size: var(--t-font-size-small);
		font-weight: var(--t-font-weight-medium);
		background-color: var(--t-color-background-root);
	}

	.legal-nav > ul {
		display: flex;
		list-style: none;
		align-items: flex-start;
	}

	a {
		display: flex;
		gap: var(--t-space-1);
		padding-inline: var(--t-space-2);
		padding-block: var(--t-space-1);
		border-radius: var(--t-radius-medium);

		&[data-icon] {
			&::before {
				content: "";
				flex: 0 0 auto;
				inline-size: 1em;
				aspect-ratio: 1 / 1;
				background-color: currentColor;
				mask: var(--s-icon) center / contain no-repeat;
			}

			&[data-icon="rss"] {
				--s-icon: var(--t-icon-rss);
			}
		}
	}
</style>
