---
import ColorSchemePicker from "./ColorSchemePicker.astro";

const isHome = Astro.url.pathname === "/";
---

<header>
	<a href="/" class="brand"><span class:list={[{ "visually-hidden": isHome }]}>Ömer Balyalı</span></a>
	<div class="actions">
		<ColorSchemePicker />
	</div>
</header>

<style>
	header {
		padding: var(--t-app-gutter);
		display: grid;
		grid-template-columns: auto 1fr auto;
		gap: var(--t-space-4);
		align-items: center;
	}

	.brand {
		grid-column: 1;
		justify-self: start;
		transition: var(--t-transition-default);
		transition-property: background-color;
		display: flex;
		gap: var(--t-space-4);
		align-items: center;
		text-decoration: none;

		&::before {
			content: "";
			display: block;
			width: 1.25rlh;
			aspect-ratio: 1 / 1;
			background-color: currentColor;
			mask-image: url("../../assets/brand/logomark.svg");
			mask-size: contain;
			mask-repeat: no-repeat;
			mask-position: center;
		}

		& > span {
			line-height: 1;
			font-size: var(--t-font-size-large);
			padding-block-start: 0.1375rlh;
			font-weight: var(--t-font-weight-bold);
			text-wrap: nowrap;
		}

		&:hover::before {
			color: var(--t-color-brand-primary);
		}
	}

	.actions {
		grid-column: 3;
		justify-self: end;
		display: flex;
		gap: var(--t-space-2);
		align-items: stretch;
		height: var(--t-space-12);
	}
</style>
