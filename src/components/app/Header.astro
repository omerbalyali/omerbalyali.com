---
const isHome = Astro.url.pathname === "/";
---

<header
	class="app-header app-container-padded"
	data-intro-visible={isHome ? "" : undefined}
	transition:persist="app-header">
	<span>
		<a href="/" class="branding">Ömer Balyalı</a>
	</span>
	<div class="intro-shell">
		<p class="intro" aria-hidden={isHome ? undefined : "true"} inert={!isHome ? "" : undefined}>
			I'm a Design Engineer at{" "}
			<a href="https://humaninterface.studio" class="studio-link">Human Interface Studio</a>{" "}
			with a focus on Accessibility, Design Systems, Branding, and Software Development.
		</p>
	</div>
</header>

<script is:inline>
	(() => {
		const listenerKey = "__appHeaderRouteState";

		if (window[listenerKey]) {
			return;
		}

		window[listenerKey] = true;

		const headerSelector = ".app-header";
		const syncHeaderRouteState = () => {
			const header = document.querySelector(headerSelector);

			if (!header) {
				return;
			}

			const intro = header.querySelector(".intro");
			const isHome = window.location.pathname === "/";

			header.toggleAttribute("data-intro-visible", isHome);

			if (intro) {
				intro.toggleAttribute("inert", !isHome);

				if (isHome) {
					intro.removeAttribute("aria-hidden");
				} else {
					intro.setAttribute("aria-hidden", "true");
				}
			}
		};

		syncHeaderRouteState();
		document.addEventListener("astro:page-load", syncHeaderRouteState);
	})();
</script>

<style>
	.app-header {
		display: flex;
		flex-direction: column;
		row-gap: 0;
		padding-block: var(--t-space-12);
		background-color: var(--t-color-background-root);
		transition: row-gap var(--t-duration-slow) var(--t-ease-out);
	}

	.app-header[data-intro-visible] {
		row-gap: var(--t-space-4);
	}

	.branding {
		:where(&) {
			--s-background-color: transparent;
			--s-outline: var(--t-border-thin) solid var(--s-outline-color);
			--s-outline-color: transparent;
		}

		max-width: max-content;
		font-weight: var(--t-font-weight-semibold);
		position: relative;
		padding-block: var(--t-space-3);
		padding-inline: var(--t-space-3);
		margin-inline: calc(var(--t-space-3) * -1);
		display: flex;
		gap: var(--t-space-3);
		align-items: center;
		border-radius: var(--t-radius-medium);
		outline-offset: 0;

		&::before {
			content: "";
			width: var(--t-space-4);
			aspect-ratio: 1 / 1;
			mask-image: var(--t-brand-logomark);
			mask-repeat: no-repeat;
			margin-block-end: 3.75%;
			background-color: currentColor;
		}

		&:is(:hover, :active, :focus-visible) {
			--s-color: var(--t-color-accent);
		}

		&:focus-visible {
			--s-background-color: color-mix(in oklch, currentColor 5%, transparent);
			--s-outline-color: color-mix(in oklch, currentColor 40%, transparent);
		}
	}

	.intro-shell {
		display: grid;
		grid-template-rows: 0fr;
		transition: grid-template-rows var(--t-duration-fast) var(--t-ease-out);
	}

	.app-header[data-intro-visible] .intro-shell {
		grid-template-rows: 1fr;
	}

	.intro {
		min-block-size: 0;
		overflow: clip;
		opacity: 0;
		transition: opacity var(--t-duration-base) var(--t-ease-out);
	}

	.app-header[data-intro-visible] .intro {
		opacity: 1;
		transition-delay: var(--t-duration-fast);
	}

	.studio-link {
		font-weight: var(--t-font-weight-semibold);
		color: var(--t-color-accent);
	}

	@media (prefers-reduced-motion: reduce) {
		.app-header,
		.intro,
		.intro-shell {
			transition: none;
		}
	}
</style>
