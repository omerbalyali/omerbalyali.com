---
const { pathname } = Astro.url;

const links = [
	{ href: "/", label: "Home", priority: 3, isHome: true },
	{ href: "/works/", label: "Works", priority: 2 },
	{ href: "/writing/", label: "Writing", priority: 2 },
	{ href: "/about/", label: "About", priority: 1 },
	{
		href: "https://linkedin.com/in/omerbalyali",
		label: "LinkedIn",
		priority: 0,
		external: true,
	},
	{
		href: "https://github.com/omerbalyali",
		label: "GitHub",
		priority: 0,
		external: true,
	},
	{ href: "/privacy-policy/", label: "Privacy Policy", priority: 0 },
	{ href: "/legal-notice/", label: "Legal Notice", priority: 0 },
] as const;

const isActive = (href: string) => {
	if (!href.startsWith("/")) return false;
	return href === "/" ? pathname === "/" : pathname.startsWith(href);
};

const mainLinks = links.filter((link) => link.priority > 0);
const menuLinks = links.filter((link) => !("isHome" in link && link.isHome));
---

<div>
	<nav
		id="navigation"
		class="navbar"
		aria-label="Primary"
		transition:persist="navbar"
		transition:animate="none">
		<ul class="navbar-list">
			{
				mainLinks.map((link) => (
					<li
						class="navbar-item"
						data-priority={link.priority}
						data-home={"isHome" in link && link.isHome ? "" : undefined}>
						<a
							href={link.href}
							aria-current={isActive(link.href) ? "page" : undefined}
							aria-label={"isHome" in link && link.isHome ? "Home" : undefined}>
							{"isHome" in link && link.isHome ? <span class="navbar-logo" aria-hidden="true" /> : link.label}
						</a>
					</li>
				))
			}
			<li class="navbar-more">
				<button
					type="button"
					aria-haspopup="true"
					aria-expanded="false"
					aria-controls="navbar-menu"
					aria-label="More links">
					<span class="navbar-icon" aria-hidden="true"></span>
				</button>
			</li>
		</ul>
		<ul class="navbar-menu" id="navbar-menu">
			{
				menuLinks.map((link) => (
					<li class="navbar-menu-item" data-priority={link.priority}>
						<a
							href={link.href}
							aria-current={isActive(link.href) ? "page" : undefined}
							{...("external" in link && link.external
								? { target: "_blank", rel: "noopener noreferrer" }
								: {})}>
							{link.label}
						</a>
					</li>
				))
			}
		</ul>
	</nav>
	<div class="overlay"></div>
</div>

<style>
	.overlay {
		content: "";
		position: fixed;
		width: 100%;
		height: 5rem;
		background: linear-gradient(to top, var(--t-color-background-page), transparent);
		z-index: 5;
		pointer-events: none;
		inset-block-end: 0;
		inset-inline: auto;
	}

	.navbar {
		:where(&) {
			--s-inset-inline: 0;
			--s-margin-inline-end: auto;
			--s-opacity: 0;
			--s-transition: none;
		}

		position: fixed;
		max-width: max-content;
		inset-block-end: 1lh;
		inset-inline: var(--s-inset-inline);
		margin-inline: auto var(--s-margin-inline-end);
		padding: var(--t-space-1-5);
		z-index: var(--t-elevation-fixed);
		pointer-events: auto;
		border-radius: var(--t-radius-full);
		border: var(--t-border-thin) solid hsl(0deg 0% 0% / 7%);
		background-color: light-dark(hsl(0deg 0% 98% / 90%), hsl(0deg 0% 8% / 90%));
		backdrop-filter: blur(3px);
		box-shadow:
			inset 0 0 0 1px light-dark(white, hsl(0deg 0% 100% / 7%)),
			0 2px 2px 0 hsl(0deg 0% 0% / 2%),
			0 10px 15px 0 hsl(0deg 0% 0% / 2%);
		opacity: var(--s-opacity);

		&[data-ready] {
			--s-opacity: 1;
			--s-transition: opacity var(--t-duration-base) var(--t-ease-out);
		}

		&[data-ready] .navbar-list::before {
			opacity: 1;
			transition:
				inset-inline-start var(--t-duration-base) var(--t-ease-out),
				width var(--t-duration-base) var(--t-ease-out),
				opacity var(--t-duration-fast) var(--t-ease-out);
		}

		&[data-resizing] .navbar-list::before {
			transition: none;
		}

		&[data-indicator-hidden] .navbar-list::before {
			opacity: 0;
		}

		@media (width <= 379px) {
			--s-inset-inline: auto 0;
			--s-margin-inline-end: var(--t-space-4);
		}

		@media (prefers-reduced-motion: reduce) {
			--s-transition: none;
		}
	}

	.navbar-list {
		position: relative;
		display: flex;
		align-items: stretch;
		isolation: isolate;
		overflow: hidden;
		border-radius: var(--t-radius-full);

		& > li {
			/* flex-shrink: 0; */
			display: flex;

			& > a,
			& > button {
				:where(&) {
					--s-color: color-mix(in oklab, currentColor 75%, transparent);
					--s-outline: ;
					--s-outline-offset: ;
					--s-transition: color var(--t-duration-fast) var(--t-ease-out);
				}

				display: flex;
				align-items: center;
				padding-block: var(--t-space-3);
				padding-inline: var(--t-space-4);
				border-radius: var(--t-radius-full);
				border: 0;
				text-decoration: none;
				font-size: var(--t-font-size-small);
				font-weight: var(--t-font-weight-medium);
				color: var(--s-color);
				background: transparent;
				transition: var(--s-transition);
				cursor: pointer;

				&:hover {
					--s-color: currentColor;
				}

				&:focus-visible {
					--s-outline: var(--t-border-default) solid currentColor;
					--s-outline-offset: var(--t-border-thin);
				}

				&[aria-current="page"] {
					--s-color: var(--t-color-accent);
				}

				@media (prefers-reduced-motion: reduce) {
					--s-transition: none;
				}
			}

			&[data-home] > a {
				/* padding-inline: 0.875rem; */
			}

			& > button {
				display: grid;
				place-items: center;
				aspect-ratio: 1 / 1;
				block-size: var(--t-space-12);
				background-color: color-mix(in oklab, currentColor 5%, transparent);

				[data-menu-active] & {
					color: var(--t-color-accent);
				}
			}

			&[data-priority="1"] {
				@media (width <= 519px) {
					display: none;
				}
			}

			&[data-priority="2"] {
				@media (width <= 379px) {
					display: none;
				}
			}

			.navbar[data-collapsed] &:not([data-priority="3"]) {
				@media (width <= 639px) and (height <= 1199px) {
					display: none;
				}
			}
		}

		/* Active Route Indicator */
		&::before {
			content: "";
			position: absolute;
			inset-block: 0;
			inset-inline-start: var(--indicator-left, 0);
			width: var(--indicator-width, 0);
			border-radius: var(--t-radius-full);
			border: var(--t-border-thin) solid color-mix(in oklab, var(--t-color-accent) 7%, transparent);
			background-color: color-mix(in oklab, var(--t-color-accent) 5%, transparent);
			z-index: -1;
			opacity: 0;

			@media (prefers-reduced-motion: reduce) {
				transition: none;
			}
		}

		/* Home Link Logo */
		.navbar-logo {
			display: flex;
			inline-size: 1rem;
			aspect-ratio: 1 / 1;
			background: currentcolor;
			mask: var(--t-brand-logomark) center / contain no-repeat;
		}

		/* More Button Icon */
		.navbar-icon {
			display: block;
			aspect-ratio: 4 / 1;
			inline-size: 0.5lh;
			background: currentcolor;
			mask: var(--navbar-icon-more) center / contain no-repeat;

			--navbar-icon-more: url('data:image/svg+xml;charset=utf-8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 12 3"><circle cx="1.5" cy="1.5" r="1.5"/><circle cx="6" cy="1.5" r="1.5"/><circle cx="10.5" cy="1.5" r="1.5"/></svg>');
		}
	}

	.navbar-menu {
		position: absolute;
		inset-inline-end: 0;
		inset-block-end: 100%;
		margin-block-end: var(--t-space-3);
		min-inline-size: var(--t-space-48);
		padding: var(--t-space-2);
		border-radius: var(--t-radius-xlarge);
		border: var(--t-border-thin) solid var(--t-color-border-primary);
		background-color: color-mix(in oklab, var(--t-color-background-page) 85%, transparent);
		backdrop-filter: blur(8px);
		display: none;
		flex-direction: column;
		gap: var(--t-space-1-5);

		.navbar:has(.navbar-more > button[aria-expanded="true"]) & {
			display: flex;
		}

		& > li {
			&:is([data-priority="1"], [data-priority="2"]) {
				display: none;
			}

			&[data-priority="1"] {
				@media (width <= 519px) {
					display: revert;
				}
			}

			&[data-priority="2"] {
				@media (width <= 379px) {
					display: revert;
				}
			}

			.navbar[data-collapsed] &[data-priority] {
				@media (width <= 639px) and (height <= 1199px) {
					display: revert;
				}
			}

			& > a {
				display: block;
				padding-inline: var(--t-space-4);
				padding-block: var(--t-space-2);
				border-radius: var(--t-radius-large);
				font-size: var(--t-font-size-small);
				font-weight: var(--t-font-weight-medium);
				color: color-mix(in oklab, currentColor 75%, transparent);
				text-decoration: none;
				transition:
					color var(--t-duration-fast) var(--t-ease-out),
					background-color var(--t-duration-fast) var(--t-ease-out);

				&:hover {
					color: currentcolor;
					background-color: color-mix(in oklab, currentColor 5%, transparent);
				}

				&[aria-current="page"] {
					color: var(--t-color-accent);
					background-color: color-mix(in oklab, currentColor 10%, transparent);
				}

				@media (prefers-reduced-motion: reduce) {
					transition: none;
				}
			}
		}
	}
</style>

<script>
	let bound = false;

	function setupNavBar() {
		if (bound) return;
		const nav = document.querySelector<HTMLElement>(".navbar");
		if (!nav) return;
		bound = true;

		const list = nav.querySelector<HTMLElement>(".navbar-list")!;
		const moreItem = nav.querySelector<HTMLElement>(".navbar-more")!;
		const moreButton = moreItem.querySelector<HTMLButtonElement>("button")!;
		const menu = nav.querySelector<HTMLElement>(".navbar-menu")!;

		let lastWidth = 0;
		let resizeTimer: number | undefined;
		let lastScrollY = window.scrollY;
		let firstUpdate = true;
		let currentAnimation: Animation | null = null;

		const isLinkActive = (href: string) => {
			if (!href.startsWith("/")) return false;
			const path = window.location.pathname;
			return href === "/" ? path === "/" : path.startsWith(href);
		};

		const updateAriaCurrent = () => {
			nav.querySelectorAll<HTMLAnchorElement>("a[href]").forEach((anchor) => {
				if (isLinkActive(anchor.getAttribute("href") || "")) {
					anchor.setAttribute("aria-current", "page");
				} else {
					anchor.removeAttribute("aria-current");
				}
			});
		};

		const updateIndicator = () => {
			const visibleActive = list.querySelector<HTMLAnchorElement>('.navbar-item > a[aria-current="page"]');
			const menuActive = menu.querySelector<HTMLAnchorElement>('a[aria-current="page"]');

			let target: HTMLElement | null = null;
			const activeItem = (visibleActive?.parentElement ?? null) as HTMLElement | null;
			if (activeItem && activeItem.offsetParent !== null) {
				target = activeItem;
			} else if (menuActive) {
				target = moreItem;
			}

			if (target) {
				nav.style.setProperty("--indicator-left", `${target.offsetLeft}px`);
				nav.style.setProperty("--indicator-width", `${target.offsetWidth}px`);
				delete nav.dataset.indicatorHidden;
				if (target === moreItem) {
					nav.dataset.menuActive = "";
				} else {
					delete nav.dataset.menuActive;
				}
			} else {
				nav.dataset.indicatorHidden = "";
				delete nav.dataset.menuActive;
			}
		};

		const flip = () => {
			const newWidth = nav.getBoundingClientRect().width;
			if (lastWidth && Math.abs(lastWidth - newWidth) > 0.5) {
				currentAnimation?.cancel();
				currentAnimation = nav.animate([{ width: `${lastWidth}px` }, { width: `${newWidth}px` }], {
					duration: 200,
					easing: "ease-out",
				});
				currentAnimation.finished
					.then(() => {
						currentAnimation = null;
						lastWidth = nav.getBoundingClientRect().width;
						updateIndicator();
					})
					.catch(() => {
						/* canceled */
					});
			}
			lastWidth = newWidth;
		};

		const beginResizing = () => {
			nav.dataset.resizing = "";
			window.clearTimeout(resizeTimer);
			resizeTimer = window.setTimeout(() => {
				delete nav.dataset.resizing;
			}, 150);
		};

		const ro = new ResizeObserver(() => {
			if (currentAnimation) return;
			flip();
			updateIndicator();
		});
		ro.observe(nav);

		window.addEventListener("resize", beginResizing, { passive: true });

		const updateCollapse = () => {
			const isMobile = window.innerWidth < 640 && window.innerHeight < 1200;
			const y = window.scrollY;
			const isCollapsed = nav.dataset.collapsed !== undefined;

			if (!isMobile || y <= 0) {
				if (isCollapsed) {
					delete nav.dataset.collapsed;
					beginResizing();
				}
				lastScrollY = y;
				return;
			}
			if (y > lastScrollY && !isCollapsed) {
				nav.dataset.collapsed = "";
				beginResizing();
			} else if (y < lastScrollY && isCollapsed) {
				delete nav.dataset.collapsed;
				beginResizing();
			}
			lastScrollY = y;
		};
		window.addEventListener("scroll", updateCollapse, { passive: true });

		const closeMenu = () => moreButton.setAttribute("aria-expanded", "false");

		moreButton.addEventListener("click", () => {
			const expanded = moreButton.getAttribute("aria-expanded") === "true";
			moreButton.setAttribute("aria-expanded", String(!expanded));
		});

		document.addEventListener("click", (event) => {
			if (!nav.contains(event.target as Node)) closeMenu();
		});

		document.addEventListener("keydown", (event) => {
			if (event.key === "Escape") closeMenu();
		});

		menu.addEventListener("click", (event) => {
			if ((event.target as HTMLElement).closest("a")) closeMenu();
		});

		document.addEventListener("astro:page-load", () => {
			closeMenu();
			updateAriaCurrent();
			updateIndicator();
			if (firstUpdate) {
				requestAnimationFrame(() => {
					requestAnimationFrame(() => {
						nav.dataset.ready = "";
					});
				});
				firstUpdate = false;
			}
		});
	}

	setupNavBar();
</script>
