---
const { pathname } = Astro.url;

const links = [
	{ href: "/", label: "Home", priority: 3, isHome: true },
	{ href: "/works/", label: "Works", priority: 2 },
	{ href: "/about/", label: "About", priority: 2 },
	{
		href: "https://linkedin.com/in/omerbalyali",
		label: "LinkedIn",
		icon: "linkedin",
		priority: 0,
		external: true,
	},
	{
		href: "https://github.com/omerbalyali",
		label: "GitHub",
		icon: "github",
		priority: 0,
		external: true,
	},
	{
		href: "https://bsky.app/profile/omerbalyali.com",
		label: "Bluesky",
		icon: "bluesky",
		priority: 0,
		external: true,
	},
	{
		href: "https://x.com/omerbalyali",
		label: "X",
		icon: "x",
		priority: 0,
		external: true,
	},
] as const;

const isActive = (href: string) => {
	if (!href.startsWith("/")) return false;
	return href === "/" ? pathname === "/" : pathname.startsWith(href);
};

const mainLinks = links.filter((link) => link.priority > 0);
const menuLinks = links.filter((link) => !("isHome" in link && link.isHome));
---

<div>
	<nav id="navigation" class="navbar" aria-label="Primary" transition:persist="navbar">
		<div class="navbar-surface" aria-hidden="true"></div>
		<ul class="navbar-list">
			{
				mainLinks.map((link) => (
					<li
						class="navbar-item"
						data-priority={link.priority}
						data-home={"isHome" in link && link.isHome ? "" : undefined}>
						<a
							href={link.href}
							aria-current={isActive(link.href) ? "page" : undefined}
							aria-label={"isHome" in link && link.isHome ? "Home" : undefined}>
							{"isHome" in link && link.isHome ? <span class="navbar-logo" aria-hidden="true" /> : link.label}
						</a>
					</li>
				))
			}
			<li class="navbar-more">
				<button
					type="button"
					aria-haspopup="true"
					aria-expanded="false"
					aria-controls="navbar-menu"
					aria-label="More links">
					<span class="navbar-icon" aria-hidden="true"></span>
				</button>
			</li>
			<li role="presentation" aria-hidden="true">
				<div class="navbar-indicator"></div>
			</li>
		</ul>
		<ul class="navbar-menu" id="navbar-menu">
			{
				menuLinks.map((link) => (
					<li class="navbar-menu-item" data-priority={link.priority}>
						<a
							href={link.href}
							aria-current={isActive(link.href) ? "page" : undefined}
							data-icon={"icon" in link ? link.icon : undefined}
							{...("external" in link && link.external
								? { target: "_blank", rel: "noopener noreferrer" }
								: {})}>
							{link.label}
						</a>
					</li>
				))
			}
		</ul>
	</nav>
	<div class="overlay"></div>
</div>

<style>
	/* stylelint-disable custom-property-pattern */
	@layer components {
		.overlay {
			position: fixed;
			width: 100%;
			height: var(--t-space-20);
			mask: linear-gradient(to top, var(--t-color-background-page), transparent);
			backdrop-filter: blur(2px);
			z-index: 5;
			pointer-events: none;
			inset-block-end: 0;
			inset-inline: auto;
		}

		.navbar {
			:where(&) {
				--s-inset-inline: 0;
				--s-margin-inline-end: auto;
				--s-opacity: 1;
				--s-transition: none;
			}

			position: fixed;
			max-width: max-content;
			inset-block-end: 1lh;
			inset-inline: var(--s-inset-inline);
			margin-inline: auto var(--s-margin-inline-end);
			padding: var(--t-space-1-5);
			z-index: var(--t-elevation-fixed);
			pointer-events: auto;
			opacity: var(--s-opacity);
			transition: var(--s-transition);
			user-select: none;
			/* stylelint-disable-next-line property-no-vendor-prefix */
			-webkit-user-select: none;

			&[data-ready] {
				--s-transition: none;
			}

			@media (width <= 319px) {
				--s-inset-inline: auto 0;
				--s-margin-inline-end: var(--t-space-4);
			}

			@media (prefers-reduced-motion: reduce) {
				--s-transition: none;
			}
		}

		.navbar-surface {
			position: absolute;
			inset: 0;
			z-index: -1;
			border-radius: var(--t-radius-full);
			border: var(--t-border-thin) solid light-dark(hsl(0 0% 0% / 0.07), hsl(0 0% 25%));
			background-color: light-dark(hsl(0 0% 100% / 0.85), hsl(0 0% 18% / 0.9));
			backdrop-filter: blur(3px);
			box-shadow:
				inset 0 0 0 1px light-dark(white, hsl(0 0% 15% / 0.5)),
				0 2px 2px 0 hsl(0 0% 0% / 0.02),
				0 10px 15px 0 hsl(0 0% 0% / 0.02);
			pointer-events: none;
		}

		/* Active Route Indicator */
		/* stylelint-disable-next-line no-descending-specificity */
		.navbar-indicator {
			:where(&) {
				--s-inset-inline-start: var(--c-navbar-indicator-left, 0);
				--s-width: var(--c-navbar-indicator-width, 0);
				--s-opacity: var(--c-navbar-indicator-opacity, 0);
				--s-transition: var(--c-navbar-indicator-transition, none);
			}

			position: absolute;
			inset-block: 0;
			inset-inline-start: var(--s-inset-inline-start);
			width: var(--s-width);
			border-radius: var(--t-radius-full);
			border: var(--t-border-thin) solid color-mix(in oklab, var(--t-color-accent) 7%, transparent);
			background-color: color-mix(in oklab, var(--t-color-accent) 5%, transparent);
			z-index: -1;
			opacity: var(--s-opacity);
			transition: var(--s-transition);

			.navbar[data-ready] & {
				--s-opacity: 1;
				--s-transition:
					inset-inline-start var(--t-duration-base) var(--t-ease-out),
					width var(--t-duration-base) var(--t-ease-out), opacity var(--t-duration-fast) var(--t-ease-out);
			}

			.navbar[data-resizing] & {
				--s-transition: none;
			}

			.navbar[data-indicator-hidden] & {
				--s-opacity: 0;
			}

			@media (prefers-reduced-motion: reduce) {
				--s-transition: none;
			}
		}

		/* Navbar List (and Visible Items) */
		.navbar-list {
			position: relative;
			display: flex;
			align-items: stretch;
			isolation: isolate;
			border-radius: var(--t-radius-full);

			& > li {
				:where(&) {
					--s-display: flex;
				}

				display: var(--s-display);

				&[data-priority="1"] {
					@media (width <= 389px) {
						--s-display: none;
					}
				}

				&[data-priority="2"] {
					@media (width <= 319px) {
						--s-display: none;
					}
				}

				& > a,
				& > button {
					:where(&) {
						--s-background-color: transparent;
						--s-color: color-mix(in oklab, currentColor 75%, transparent);
						--s-display: flex;
						--s-outline-color: transparent;
						--s-transition: color var(--t-duration-base) var(--t-ease-out);
					}

					display: var(--s-display);
					position: relative;
					align-items: center;
					padding-block: var(--t-space-3);
					padding-inline: var(--t-space-4);
					border-radius: var(--t-radius-full);
					border: 0;
					font-size: var(--t-font-size-small);
					font-weight: var(--t-font-weight-medium);
					color: var(--s-color);
					background-color: var(--s-background-color);
					outline: var(--t-border-default) solid var(--s-outline-color);
					outline-offset: var(--t-border-thin);
					transition: var(--s-transition);

					&:not(button):hover {
						--s-color: var(--t-color-accent);
					}

					&:focus-visible {
						--s-outline-color: currentColor;
					}

					&[aria-current="page"] {
						--s-color: var(--t-color-accent);
					}

					&:is(button) {
						--s-display: grid;

						place-items: center;
						aspect-ratio: 1 / 1;
						block-size: var(--t-space-12);

						.navbar[data-menu-active] & {
							--s-color: var(--t-color-accent);
						}

						&[aria-expanded="true"] {
							--s-background-color: color-mix(in oklab, currentColor 5%, transparent);
						}
					}

					/* Increase clickable area */
					&::after {
						content: "";
						position: absolute;
						inset: 0;
					}

					@media (prefers-reduced-motion: reduce) {
						--s-transition: none;
					}
				}
			}

			/* Home Link Logo */
			.navbar-logo {
				display: flex;
				inline-size: 1rem;
				aspect-ratio: 1 / 1;
				background: currentColor;
				mask: var(--t-brand-logomark) center / contain no-repeat;
			}

			/* More Button Icon */
			.navbar-icon {
				display: block;
				aspect-ratio: 4 / 1;
				inline-size: 0.5lh;
				background: currentColor;
				mask: var(--_navbar-icon-more) center / contain no-repeat;

				--_navbar-icon-more: url('data:image/svg+xml;charset=utf-8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 12 3"><circle cx="1.5" cy="1.5" r="1.5"/><circle cx="6" cy="1.5" r="1.5"/><circle cx="10.5" cy="1.5" r="1.5"/></svg>');
			}
		}

		/* Dropdown Menu (More Items) */
		.navbar-menu {
			:where(&) {
				--s-display: none;
			}

			position: absolute;
			inset-inline-end: 0;
			inset-block-end: 100%;
			margin-block-end: var(--t-space-3);
			min-inline-size: var(--t-space-48);
			padding: var(--t-space-2);
			border-radius: var(--t-radius-xlarge);
			border: var(--t-border-thin) solid var(--t-color-border-primary);
			background-color: color-mix(in oklab, var(--t-color-background-page) 85%, transparent);
			backdrop-filter: blur(8px);
			display: var(--s-display);
			flex-direction: column;
			gap: var(--t-space-1-5);

			.navbar:has(.navbar-more > button[aria-expanded="true"]) & {
				--s-display: flex;
			}

			& > li {
				:where(&) {
					--s-display: block;
				}

				display: var(--s-display);

				&:is([data-priority="1"], [data-priority="2"]) {
					--s-display: none;
				}

				&[data-priority="1"] {
					@media (width <= 389px) {
						--s-display: revert;
					}
				}

				&[data-priority="2"] {
					@media (width <= 319px) {
						--s-display: revert;
					}
				}

				& > a {
					:where(&) {
						--s-display: block;
						--s-color: color-mix(in oklab, currentColor 75%, transparent);
						--s-background-color: transparent;
						--s-transition:
							color var(--t-duration-fast) var(--t-ease-out),
							background-color var(--t-duration-fast) var(--t-ease-out);
					}

					display: var(--s-display);
					width: 100%;
					padding-inline: var(--t-space-4);
					padding-block: var(--t-space-2);
					border-radius: var(--t-radius-large);
					font-size: var(--t-font-size-small);
					font-weight: var(--t-font-weight-medium);
					color: var(--s-color);
					background-color: var(--s-background-color);
					transition: var(--s-transition);

					&[data-icon] {
						--s-display: flex;

						align-items: center;
						gap: var(--t-space-2);
					}

					&[data-icon]::before {
						content: "";
						flex: 0 0 auto;
						inline-size: 1em;
						aspect-ratio: 1 / 1;
						background-color: currentColor;
						mask: var(--s-icon) center / contain no-repeat;
					}

					&[data-icon="github"] {
						--s-icon: var(--t-icon-github);
					}

					&[data-icon="linkedin"] {
						--s-icon: var(--t-icon-linkedin);
					}

					&[data-icon="bluesky"] {
						--s-icon: var(--t-icon-bluesky);
					}

					&[data-icon="x"] {
						--s-icon: var(--t-icon-x);
					}

					&:hover {
						--s-color: var(--t-color-accent);
						--s-background-color: color-mix(in oklab, currentColor 5%, transparent);
					}

					&[aria-current="page"] {
						--s-color: var(--t-color-accent);
						--s-background-color: color-mix(in oklab, currentColor 10%, transparent);
					}

					@media (prefers-reduced-motion: reduce) {
						--s-transition: none;
					}
				}
			}
		}
	}
</style>

<script>
	let bound = false;

	function setupNavBar() {
		if (bound) return;
		const nav = document.querySelector<HTMLElement>(".navbar");
		if (!nav) return;
		bound = true;

		const indicator = nav.querySelector<HTMLElement>(".navbar-indicator")!;
		const list = nav.querySelector<HTMLElement>(".navbar-list")!;
		const moreItem = nav.querySelector<HTMLElement>(".navbar-more")!;
		const moreButton = moreItem.querySelector<HTMLButtonElement>("button")!;
		const menu = nav.querySelector<HTMLElement>(".navbar-menu")!;

		let lastWidth = 0;
		let resizeTimer: number | undefined;
		let firstUpdate = true;
		let currentAnimation: Animation | null = null;

		const isLinkActive = (href: string) => {
			if (!href.startsWith("/")) return false;
			const path = window.location.pathname;
			return href === "/" ? path === "/" : path.startsWith(href);
		};

		const updateAriaCurrent = () => {
			nav.querySelectorAll<HTMLAnchorElement>("a[href]").forEach((anchor) => {
				if (isLinkActive(anchor.getAttribute("href") || "")) {
					anchor.setAttribute("aria-current", "page");
				} else {
					anchor.removeAttribute("aria-current");
				}
			});
		};

		const updateIndicator = () => {
			const visibleActive = list.querySelector<HTMLAnchorElement>('.navbar-item > a[aria-current="page"]');
			const menuActive = menu.querySelector<HTMLAnchorElement>('a[aria-current="page"]');

			let target: HTMLElement | null = null;
			const activeItem = (visibleActive?.parentElement ?? null) as HTMLElement | null;
			if (activeItem && activeItem.offsetParent !== null) {
				target = activeItem;
			} else if (menuActive) {
				target = moreItem;
			}

			if (target) {
				indicator.style.setProperty("--c-navbar-indicator-left", `${target.offsetLeft}px`);
				indicator.style.setProperty("--c-navbar-indicator-width", `${target.offsetWidth}px`);
				delete nav.dataset.indicatorHidden;
				if (target === moreItem) {
					nav.dataset.menuActive = "";
				} else {
					delete nav.dataset.menuActive;
				}
			} else {
				nav.dataset.indicatorHidden = "";
				delete nav.dataset.menuActive;
			}
		};

		const flip = () => {
			const newWidth = nav.getBoundingClientRect().width;
			if (lastWidth && lastWidth - newWidth > 0.5) {
				currentAnimation?.cancel();
				currentAnimation = nav.animate([{ width: `${lastWidth}px` }, { width: `${newWidth}px` }], {
					duration: 200,
					easing: "ease-out",
				});
				currentAnimation.finished
					.then(() => {
						currentAnimation = null;
						lastWidth = nav.getBoundingClientRect().width;
						updateIndicator();
					})
					.catch(() => {
						/* canceled */
					});
			}
			lastWidth = newWidth;
		};

		const beginResizing = () => {
			nav.dataset.resizing = "";
			window.clearTimeout(resizeTimer);
			resizeTimer = window.setTimeout(() => {
				delete nav.dataset.resizing;
			}, 150);
		};

		let pendingFrame: number | undefined;
		const ro = new ResizeObserver(() => {
			if (currentAnimation || pendingFrame !== undefined) return;
			pendingFrame = requestAnimationFrame(() => {
				pendingFrame = undefined;
				if (currentAnimation) return;
				flip();
				updateIndicator();
			});
		});
		ro.observe(nav);

		window.addEventListener("resize", beginResizing, { passive: true });

		const closeMenu = () => moreButton.setAttribute("aria-expanded", "false");

		moreButton.addEventListener("click", () => {
			const expanded = moreButton.getAttribute("aria-expanded") === "true";
			moreButton.setAttribute("aria-expanded", String(!expanded));
		});

		document.addEventListener("click", (event) => {
			if (!nav.contains(event.target as Node)) closeMenu();
		});

		document.addEventListener("keydown", (event) => {
			if (event.key === "Escape") closeMenu();
		});

		menu.addEventListener("click", (event) => {
			if ((event.target as HTMLElement).closest("a")) closeMenu();
		});

		document.addEventListener("astro:page-load", () => {
			closeMenu();
			updateAriaCurrent();
			updateIndicator();
			if (firstUpdate) {
				requestAnimationFrame(() => {
					requestAnimationFrame(() => {
						nav.dataset.ready = "";
					});
				});
				firstUpdate = false;
			}
		});
	}

	setupNavBar();
</script>
