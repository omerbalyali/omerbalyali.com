---
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import type { PageMetadata } from "../../lib/seo";
import { absoluteUrl, resolveTitle, serializeDate } from "../../lib/seo";
import { SITE } from "../../site";
import "../../styles/index.css";

interface Props extends PageMetadata {}

const {
	title,
	description = SITE.description,
	canonicalURL = Astro.url.pathname,
	ogImage: providedOgImage,
	ogImageAlt,
	ogImageWidth: providedOgImageWidth,
	ogImageHeight: providedOgImageHeight,
	type = "website",
	publishedTime,
	modifiedTime,
	tags = [],
	noindex = false,
	structuredData,
} = Astro.props as Props;

const pageTitle = resolveTitle(title);
const canonicalHref = absoluteUrl(canonicalURL);
const usingDefaultOgImage = !providedOgImage && Boolean(SITE.og.defaultImage);
const ogImage = providedOgImage ?? SITE.og.defaultImage;
const ogImageHref = ogImage ? absoluteUrl(ogImage) : undefined;
const ogImageWidth = providedOgImageWidth ?? (usingDefaultOgImage ? SITE.og.defaultImageWidth : undefined);
const ogImageHeight = providedOgImageHeight ?? (usingDefaultOgImage ? SITE.og.defaultImageHeight : undefined);
const publishedIso = serializeDate(publishedTime);
const modifiedIso = serializeDate(modifiedTime);
const robots = noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large";
const schemas = Array.isArray(structuredData) ? structuredData : structuredData ? [structuredData] : [];
const plausibleDomain = new URL(SITE.url).hostname;
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="32x32" />
<link rel="canonical" href={canonicalHref} />
<link rel="sitemap" href="/sitemap-index.xml" />
<title>{pageTitle}</title>
<Font cssVariable="--font-inter" preload />
<Font cssVariable="--font-jetbrains-mono" preload />
<meta name="description" content={description} />
<meta name="author" content={SITE.author.name} />
<meta name="theme-color" content={SITE.themeColor} />
<meta name="robots" content={robots} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={SITE.locale} />
<meta property="og:title" content={pageTitle} />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalHref} />
<meta property="og:description" content={description} />
{ogImageHref && <meta property="og:image" content={ogImageHref} />}
{ogImageHref && <meta property="og:image:type" content="image/png" />}
{ogImageHref && ogImageWidth && <meta property="og:image:width" content={String(ogImageWidth)} />}
{ogImageHref && ogImageHeight && <meta property="og:image:height" content={String(ogImageHeight)} />}
{ogImageHref && (ogImageAlt ?? title) && <meta property="og:image:alt" content={ogImageAlt ?? pageTitle} />}
<meta name="twitter:card" content={ogImageHref ? "summary_large_image" : "summary"} />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
{ogImageHref && <meta name="twitter:image" content={ogImageHref} />}
{publishedIso && type === "article" && <meta property="article:published_time" content={publishedIso} />}
{modifiedIso && type === "article" && <meta property="article:modified_time" content={modifiedIso} />}
{type === "article" && tags.map((tag: string) => <meta property="article:tag" content={tag} />)}
{schemas.map((schema) => <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />)}
{
	import.meta.env.PROD && (
		<script is:inline define:vars={{ plausibleDomain }}>
			{`if (location.hostname === plausibleDomain && !window.__plausibleLoaded) {
	window.__plausibleLoaded = true;
	var s = document.createElement("script");
	s.defer = true;
	s.setAttribute("data-domain", plausibleDomain);
	s.src = "https://plausible.io/js/script.js";
	document.head.appendChild(s);
}`}
		</script>
	)
}
<ClientRouter />
