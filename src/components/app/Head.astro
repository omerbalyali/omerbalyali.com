---
import { Font, fontData } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import ColorSchemeScript from "./ColorSchemeScript.astro";
import { INTER_VARIANTS } from "../../lib/fonts";
import type { PageMetadata } from "../../lib/seo";
import { absoluteUrl, getImageMimeType, resolveTitle, serializeDate } from "../../lib/seo";
import { IS_PRODUCTION_SITE, SITE } from "../../site";

interface Props extends PageMetadata {}

const {
	title,
	description = SITE.description,
	canonicalURL = Astro.url.pathname,
	ogImage: providedOgImage,
	ogImageAlt,
	ogImageWidth: providedOgImageWidth,
	ogImageHeight: providedOgImageHeight,
	type = "website",
	publishedTime,
	modifiedTime,
	tags = [],
	noindex = false,
	structuredData,
} = Astro.props as Props;

const pageTitle = resolveTitle(title);
const canonicalHref = absoluteUrl(canonicalURL);
const usingDefaultOgImage = !providedOgImage && Boolean(SITE.og.defaultImage);
const ogImage = providedOgImage ?? SITE.og.defaultImage;
const ogImageHref = ogImage ? absoluteUrl(ogImage) : undefined;
const ogImageType = ogImageHref ? getImageMimeType(ogImageHref) : undefined;
const ogImageWidth = providedOgImageWidth ?? (usingDefaultOgImage ? SITE.og.defaultImageWidth : undefined);
const ogImageHeight = providedOgImageHeight ?? (usingDefaultOgImage ? SITE.og.defaultImageHeight : undefined);
const publishedIso = serializeDate(publishedTime);
const modifiedIso = serializeDate(modifiedTime);
const robots =
	noindex || !IS_PRODUCTION_SITE ? "noindex, nofollow, noarchive" : "index, follow, max-image-preview:large";
// Only the upright Latin Inter file is preloaded; fontData lists files in config order.
const interPreloads = INTER_VARIANTS.flatMap((variant, index) =>
	variant.preload ? (fontData["--font-inter"][index]?.src ?? []) : [],
);
const schemas = Array.isArray(structuredData) ? structuredData : structuredData ? [structuredData] : [];
---

<meta charset="UTF-8" />
<!-- Scheme variants: before ColorSchemeScript, which points their media at a manually chosen scheme. -->
<meta
	name="theme-color"
	content={SITE.colors.themeColor.light}
	media="(prefers-color-scheme: light)"
	data-scheme-light
/>
<meta
	name="theme-color"
	content={SITE.colors.themeColor.dark}
	media="(prefers-color-scheme: dark)"
	data-scheme-dark
/>
<ColorSchemeScript />
<meta name="viewport" content="width=device-width" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="32x32" />
<link rel="canonical" href={canonicalHref} />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={SITE.feed.title} href={SITE.feed.path} />
<title>{pageTitle}</title>
<Font cssVariable="--font-inter" />
{interPreloads.map(({ url }) => (
	<link rel="preload" href={url} as="font" type="font/woff2" crossorigin />
))}
<Font cssVariable="--font-jetbrains-mono" />
<meta name="description" content={description} />
<meta name="author" content={SITE.author.name} />
<meta name="robots" content={robots} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={SITE.locale} />
<meta property="og:title" content={pageTitle} />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalHref} />
<meta property="og:description" content={description} />
{ogImageHref && <meta property="og:image" content={ogImageHref} />}
{ogImageType && <meta property="og:image:type" content={ogImageType} />}
{ogImageHref && ogImageWidth && <meta property="og:image:width" content={String(ogImageWidth)} />}
{ogImageHref && ogImageHeight && <meta property="og:image:height" content={String(ogImageHeight)} />}
{ogImageHref && <meta property="og:image:alt" content={ogImageAlt ?? pageTitle} />}
<meta name="twitter:card" content={ogImageHref ? "summary_large_image" : "summary"} />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
{ogImageHref && <meta name="twitter:image" content={ogImageHref} />}
{publishedIso && type === "article" && <meta property="article:published_time" content={publishedIso} />}
{modifiedIso && type === "article" && <meta property="article:modified_time" content={modifiedIso} />}
{type === "article" && tags.map((tag: string) => <meta property="article:tag" content={tag} />)}
{schemas.map((schema) => (
	<script is:inline type="application/ld+json" set:html={JSON.stringify(schema)}></script>
))}
{import.meta.env.PROD && (
	<>
		<script is:inline async src="https://plausible.io/js/pa-tvo-4wkugbTWqxuFix3DB.js"></script>
		<script
			is:inline
			set:html={`window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
plausible.init()`}></script>
	</>
)}
<ClientRouter />
