---
import type { ImageMetadata } from "astro";
import type { HTMLAttributes } from "astro/types";

// Serves a local image file exactly as authored: no resizing, no re-encoding. For portfolio
// screenshots that must stay pixel-sharp, including when opened in a new tab or zoomed in.
// Use <Image> (optimized, responsive) everywhere else.

type Props = Omit<HTMLAttributes<"img">, "src" | "width" | "height"> & {
	src: ImageMetadata;
	alt: string;
};

const { src, alt, loading = "lazy", decoding = "async", ...attributes } = Astro.props;
---

<img
	src={src.src}
	width={src.width}
	height={src.height}
	alt={alt}
	loading={loading}
	decoding={decoding}
	{...attributes}
/>
