---

<section class="brand-identities">
	<header>
		<h1 class="title">Logomarks</h1>
	</header>
	<ul class="brand-grid bleed" data-bleed="wide" role="list">
		{
			identities.map((identity) => (
				<li data-identity={identity.id} data-identity-label={identity.label}>
					<svg class="logo" viewBox="0 0 420 240" role="img" aria-label={identity.label} focusable="false">
						<path d={identity.path} />
					</svg>
				</li>
			))
		}
	</ul>
</section>

<style>
	.brand-identities {
		display: flex;
		flex-direction: column;
		gap: var(--t-space-4);
		margin-block-end: var(--t-space-24);
	}

	header {
		display: flex;
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		margin-block-end: var(--t-space-4);
	}

	.title {
		font-size: var(--t-font-size-small);
		font-weight: var(--t-font-weight-semibold);
		color: color-mix(in oklch, currentColor 80%, transparent);
		letter-spacing: var(--t-letter-spacing-wide);
	}

	.brand-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--t-space-2) var(--t-space-2);
		margin-block: 0;

		& li {
			position: relative;
			display: grid;
			place-items: center;
			border-radius: var(--t-radius-medium);
			background-color: var(--t-color-background-primary);
			box-shadow: 0 0.125rem 0.25rem -0.125rem oklch(0 0 0 / 0.025);
			isolation: isolate;

			&::before {
				content: "";
				position: absolute;
				inset: 0;
				z-index: 3;
				border: var(--t-border-thin) solid var(--t-color-border-primary);
				border-radius: inherit;
				pointer-events: none;
			}

			&::after {
				content: attr(data-identity-label);
				position: absolute;
				inset: 0;
				z-index: 2;
				display: grid;
				place-items: center;
				border-radius: inherit;
				font-size: var(--t-font-size-xlarge);
				font-weight: var(--t-font-weight-semibold);
				backdrop-filter: blur(0.25rem);
				background-color: color-mix(
					in oklch,
					light-dark(white, var(--t-color-background-primary)) 80%,
					transparent
				);
				opacity: 0;
				pointer-events: none;
				transition: opacity var(--t-duration-base) var(--t-ease-in-out);
			}

			.logo {
				display: block;
				position: relative;
				z-index: 1;
				width: 100%;
				aspect-ratio: 1.75 / 1;
				min-inline-size: 0;
				color: color-mix(in oklch, currentColor 90%, transparent);
				fill: currentColor;
				transition: transform var(--t-duration-base) var(--t-ease-in-out);
			}

			&:hover {
				&::after {
					opacity: 1;
				}

				& .logo {
					transform: scale(1.05);
				}
			}
		}
	}

	@media (width >= 40rem) {
		.brand-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (width >= 48rem) {
		.brand-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	/* stylelint-disable-next-line selector-pseudo-class-no-unknown */
	:global([data-astro-transition]) :is(.brand-grid li::after, .brand-grid .logo) {
		transition: none;
	}
</style>
