---
import { getCollection } from "astro:content";
import { formatDate, getWritingPath } from "../../lib/seo";

const posts = (
	await getCollection("writing", ({ data }) => {
		return data.unlisted !== true && (import.meta.env.PROD ? data.draft !== true : true);
	})
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<section class="writings">
	<h2>Writings</h2>
	{
		posts.length > 0 ? (
			<ul class="writing-cards" role="list">
				{posts.map((post) => {
					return (
						<li>
							<a href={getWritingPath(post.id)}>
								<strong>{post.data.title}</strong>
								<time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
							</a>
						</li>
					);
				})}
			</ul>
		) : (
			<p>No published writing yet.</p>
		)
	}
</section>

<style>
	.writings {
		display: flex;
		flex-direction: column;
		gap: 1rlh;
		margin-block-end: var(--t-space-12);
	}

	ul {
		display: flex;
		flex-direction: column;
		max-width: 60rem;
	}

	a {
		:where(&) {
			--_inline-padding: var(--t-space-4);
			--s-background-color: transparent;
		}

		display: flex;
		flex-direction: column;
		gap: var(--t-space-2);
		padding-block: var(--t-space-6);
		padding-inline: var(--_inline-padding);
		margin-inline: calc(var(--_inline-padding) * -1);
		border-radius: var(--t-radius-large);
		font-size: var(--t-font-size-large);
		font-weight: var(--t-font-weight-medium);
		line-height: var(--t-font-line-height-tight);
		text-decoration: none;
		text-wrap: balance;
		transition: var(--t-transition-default);
		transition-property: color, background-color;
		background-color: var(--s-background-color);
		color: color-mix(in srgb, var(--t-color-foreground-base) 80%, transparent);

		& > strong {
			font-weight: var(--t-font-weight-semibold);
		}

		& > time {
			font-size: var(--t-font-size-xsmall);
			font-weight: var(--t-font-weight-semibold);
			color: color-mix(in srgb, currentColor 80%, transparent);
			text-wrap: nowrap;
		}

		&:hover {
			--s-background-color: var(--t-color-surface-primary);

			& > strong {
				color: var(--t-color-brand-primary);
			}

			& > time {
				color: color-mix(in srgb, var(--t-color-foreground-base) 80%, transparent);
			}
		}

		ul:has(a:hover) &:not(:hover) {
			opacity: 0.7;
		}
	}
</style>
