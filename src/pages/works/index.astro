---
import Layout from "../../layouts/Layout.astro";
import { getOgImageMetadata } from "../../lib/og-pages";
import { SITE } from "../../site";

const works = [
	{
		slug: "stateful-css",
		title: "Stateful CSS",
		status: "WIP",
	},
	{
		slug: "isometry",
		title: "Isometry",
		status: "WIP",
	},
	{
		slug: "keepspace",
		title: "Keepspace",
		status: "WIP",
	},
	{
		slug: "stateful-ui",
		title: "Stateful UI",
		status: "WIP",
	},
];

const metadata = {
	title: SITE.sections.works.title,
	description: SITE.sections.works.description,
	canonicalURL: "/works/",
	...getOgImageMetadata(Astro.url.pathname),
};
---

<Layout metadata={metadata}>
	<section class="works">
		<h1>Works</h1>
		<ul class="works-list">
			{
				works.map((work) => (
					<li>
						<a href={`/works/${work.slug}/`}>
							<h2>{work.title}</h2>
						</a>
					</li>
				))
			}
		</ul>
	</section>
</Layout>

<style>
	.works {
		display: flex;
		flex-direction: column;
		gap: var(--t-space-4);

		& > h2 {
			font-size: var(--t-font-size-small);
			font-weight: var(--t-font-weight-medium);
			color: color-mix(in oklch, currentColor 80%, transparent);
			padding: var(--t-space-1-5) 0;
		}
	}

	.works-list {
		display: flex;
		flex-direction: column;
		margin-block-end: var(--t-space-6);
	}

	.works-list > li {
		padding-block: var(--t-space-1-5);
	}

	.work-heading {
		display: flex;
		justify-content: space-between;
		align-items: center;

		strong {
			font-weight: var(--t-font-weight-semibold);
		}
	}
</style>
