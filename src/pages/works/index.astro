---
import Layout from "../../layouts/Layout.astro";
import { getOgImageMetadata } from "../../lib/og-image";
import { SITE } from "../../site";

const works = [
	{
		slug: "stateful-css",
		title: "Stateful CSS",
	},
	{
		slug: "isometry",
		title: "Isometry",
	},
	{
		slug: "keepspace",
		title: "Keepspace",
	},
	{
		slug: "stateful-ui",
		title: "Stateful UI",
	},
];

const metadata = {
	title: SITE.sections.works.title,
	description: SITE.sections.works.description,
	canonicalURL: "/works/",
	...getOgImageMetadata(Astro.url.pathname),
};
---

<Layout metadata={metadata}>
	<section class="works">
		<h1>Works</h1>
		<ul class="works-list">
			{
				works.map((work) => (
					<li>
						<a href={`/works/${work.slug}/`}>
							<h2>{work.title}</h2>
						</a>
					</li>
				))
			}
		</ul>
	</section>
</Layout>

<style>
	.works {
		display: flex;
		flex-direction: column;
		gap: var(--t-space-4);
	}

	.works-list {
		display: flex;
		flex-direction: column;
		margin-block-end: var(--t-space-6);
	}

	.works-list > li {
		padding-block: var(--t-space-1-5);
	}
</style>
