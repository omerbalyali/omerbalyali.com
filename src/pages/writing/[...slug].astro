---
import { render } from "astro:content";
import ProseLayout from "../../layouts/ProseLayout.astro";
import { getPublishedPosts, type Post } from "../../lib/writing";

export async function getStaticPaths() {
	const posts = await getPublishedPosts();

	return [
		{
			params: { slug: undefined },
			props: { redirectTo: "/" },
		},
		...posts.map((post) => ({
			params: { slug: post.id },
			props: { post },
		})),
	];
}

type Props = { post: Post } | { redirectTo: string };

const props = Astro.props as Props;

if ("redirectTo" in props) {
	return Astro.redirect(props.redirectTo, 308);
}

const { post } = props;
const { Content, remarkPluginFrontmatter } = await render(post);
---

<ProseLayout post={post} minutesRead={remarkPluginFrontmatter.minutesRead}>
	<Content />
</ProseLayout>
