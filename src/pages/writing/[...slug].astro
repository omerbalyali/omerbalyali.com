---
import { getCollection, render, type CollectionEntry } from "astro:content";
import WritingProseLayout from "../../layouts/WritingProseLayout.astro";

export async function getStaticPaths() {
	const posts = await getCollection("writing", ({ data }) => {
		return import.meta.env.PROD ? data.draft !== true : true;
	});

	return [
		{
			params: { slug: undefined },
			props: { redirectTo: "/" },
		},
		...posts.map((post) => ({
			params: { slug: post.id },
			props: { post },
		})),
	];
}

type Props = { post: CollectionEntry<"writing"> } | { redirectTo: string };

const props = Astro.props as Props;

if ("redirectTo" in props) {
	return Astro.redirect(props.redirectTo, 308);
}

const { post } = props;
const { Content, remarkPluginFrontmatter } = await render(post);
---

<WritingProseLayout post={post} minutesRead={remarkPluginFrontmatter.minutesRead}>
	<Content />
</WritingProseLayout>
