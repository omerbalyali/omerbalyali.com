---
import BrandIdentities from "../components/home/BrandIdentities.astro";
import WritingList from "../components/writing/WritingList.astro";
import Layout from "../layouts/Layout.astro";
import { createWebsiteStructuredData } from "../lib/seo";
import { SITE } from "../site";

const metadata = {
	description: SITE.description,
	canonicalURL: "/",
	structuredData: createWebsiteStructuredData(),
};
---

<Layout metadata={metadata}>
	<div class="home">
		<WritingList />
		<BrandIdentities />
	</div>
</Layout>

<style>
	.home {
		display: flex;
		flex-direction: column;
		gap: var(--t-space-16);
	}
</style>
