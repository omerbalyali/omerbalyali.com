---
import Intro from "../components/home/Intro.astro";
import Writings from "../components/home/Writings.astro";
import Layout from "../layouts/Layout.astro";
import { createPersonStructuredData, createWebsiteStructuredData } from "../lib/seo";
import { SITE } from "../site";

const metadata = {
	description: SITE.description,
	canonicalURL: "/",
	structuredData: [createWebsiteStructuredData(), createPersonStructuredData()],
};
---

<Layout metadata={metadata}>
	<h1 class="visually-hidden">{SITE.name}</h1>
	<Intro />
	<Writings />
</Layout>
