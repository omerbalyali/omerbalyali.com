---
import Layout from "./Layout.astro";

const { frontmatter = {} } = Astro.props;
const {
	title,
	description,
	canonicalURL = Astro.url.pathname,
	lang = "en",
} = frontmatter as {
	title?: string;
	description?: string;
	canonicalURL?: string;
	lang?: string;
};
---

<Layout lang={lang} metadata={{ title, description, canonicalURL }}>
	<article class="container">
		<section class="prose">
			<slot />
		</section>
	</article>
</Layout>

<style>
	@layer components {
		.container {
			max-width: 80ch;
			text-wrap: pretty;
		}
	}
</style>
