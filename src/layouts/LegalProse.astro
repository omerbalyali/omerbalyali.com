---
import Layout from "./Layout.astro";
---

<Layout>
	<article>
		<slot />
	</article>
</Layout>

<style>
	article {
		line-height: 1.625;

		strong {
			font-weight: var(--font-weight-medium);
		}

		h1 {
			font-size: var(--font-size-xl);
			margin-block-end: 1lh;
			text-wrap: pretty;
		}

		h2,
		h3,
		h4,
		h5,
		h6 {
			font-size: var(--font-size-lg);
			margin-block: 2lh 1lh;
		}

		p {
			margin-block: 1lh;
		}

		a {
			:where(&) {
				--s-text-color: currentColor;
				--s-underline-color: color-mix(in oklch, currentColor var(--opacity-muted), transparent);
			}

			color: var(--s-text-color);
			font-weight: var(--font-weight-semimedium);
			text-decoration: underline;
			text-decoration-skip-ink: all;
			text-decoration-style: var(--s-underline-style);
			transition: text-decoration-color var(--transition-preset);
		}

		:is(h2, h3, h4, h5, h6)[id] > a {
			position: relative;
			text-decoration: none;

			&:hover::before {
				content: "#";
				position: absolute;
				left: -0.875em;
				opacity: 0.5;
			}
		}

		figure {
			margin-block: 1.5lh;
		}

		blockquote {
			font-style: italic;
		}

		details,
		figcaption {
			font-size: var(--font-size-sm);
		}

		figcaption {
			margin-block: 0.25lh;
			padding-block: 0.25lh;
		}

		blockquote,
		details:not(:is(figcaption *)),
		figcaption {
			border-left: var(--border-width-thin) solid
				color-mix(in oklch, currentColor var(--opacity-moderate), transparent);
			padding-inline-start: 0.5lh;
		}

		footer {
			border-block-start: var(--border-width-hairline) solid
				color-mix(in oklch, currentColor var(--opacity-soft), transparent);
			padding-block: 1.5lh;
			margin-block: 2.5lh 1.5lh;
		}
	}
</style>
