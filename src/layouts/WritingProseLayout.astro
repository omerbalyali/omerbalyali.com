---
import { type CollectionEntry } from "astro:content";
import { getOgImageMetadata } from "../lib/og-pages";
import type { PageMetadata } from "../lib/seo";
import { createBlogPostingStructuredData, formatDate, getWritingPath } from "../lib/seo";
import Layout from "./Layout.astro";

interface Props {
	post: CollectionEntry<"writing">;
	minutesRead: number;
}

const { post, minutesRead } = Astro.props as Props;

const canonicalURL = post.data.canonicalURL ?? getWritingPath(post.id);
const ogMetadata = post.data.ogImage ? { ogImage: post.data.ogImage } : getOgImageMetadata(canonicalURL);
const metadata: PageMetadata = {
	title: post.data.title,
	description: post.data.description,
	canonicalURL,
	...ogMetadata,
	type: "article",
	publishedTime: post.data.pubDate,
	modifiedTime: post.data.updatedDate,
	tags: post.data.tags,
	structuredData: createBlogPostingStructuredData({
		title: post.data.title,
		description: post.data.description,
		path: canonicalURL,
		imagePath: ogMetadata.ogImage,
		publishedTime: post.data.pubDate,
		modifiedTime: post.data.updatedDate,
		tags: post.data.tags,
	}),
};
---

<Layout metadata={metadata}>
	<article>
		<header>
			{post.data.series && <p>Series: {post.data.series}</p>}
			<h1>{post.data.title}</h1>
			<div class="meta-info">
				<time
					datetime={post.data.pubDate.toISOString()}
					title={post.data.updatedDate ? `Updated ${formatDate(post.data.updatedDate)}` : undefined}
					>{formatDate(post.data.pubDate)}</time
				>
				<span class="reading-time">{minutesRead}</span>
			</div>
		</header>

		<section class="prose">
			<slot />

			<footer>
				Find me on:
				<a href="https://www.linkedin.com/in/omerbalyali/" rel="external">LinkedIn</a>,
				<a href="https://bsky.app/profile/omerbalyali.com" rel="external">Bluesky</a>, or
				<a href="https://twitter.com/omerbalyali" rel="external">X</a>
			</footer>
		</section>
	</article>

	<style>
		header {
			margin-block-end: 2lh;

			& > h1 {
				font-size: var(--t-font-size-large);
				letter-spacing: var(--t-letter-spacing-tight);
				margin-block-end: 1lh;
			}
		}

		.meta-info {
			display: flex;
			gap: 0.375lh;
			margin-block-end: 1.5lh;
			font-size: var(--t-font-size-small);
			font-weight: var(--t-font-weight-medium);
			color: color-mix(in oklch, currentColor 70%, transparent);

			.reading-time::before {
				content: "•";
				margin-inline-end: 0.375lh;
				font-size: var(--t-font-size-xsmall);
				color: color-mix(in oklch, currentColor 70%, transparent);
			}
		}

		footer {
			border-block-start: var(--t-border-thin) solid color-mix(in oklch, currentColor 10%, transparent);
			padding-block: 1.5lh;
			margin-block: 2.5lh 0;

			& > a {
				font-weight: var(--t-font-weight-semibold);
			}
		}
	</style>
</Layout>
