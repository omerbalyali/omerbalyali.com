---
import type { CollectionEntry } from "astro:content";
import { getOgImageMetadata } from "../lib/og-image";
import type { PageMetadata } from "../lib/seo";
import { SITE } from "../site";
import Layout from "./Layout.astro";

interface Props {
	work: CollectionEntry<"works">;
}

const { work } = Astro.props;
const { title, year, description, ogImage } = work.data;
const ogMetadata = ogImage ? { ogImage } : getOgImageMetadata(Astro.url.pathname);
const metadata: PageMetadata = {
	title,
	description: description || SITE.sections.works.description,
	canonicalURL: Astro.url.pathname,
	noindex: true,
	...ogMetadata,
	type: "article",
};
// `year` is a single year or a range like "2025-2026"; each end gets its own valid <time>.
const years = year.split(/\s*[-–]\s*/).filter(Boolean);
---

<Layout metadata={metadata}>
	<article>
		<header>
			<h1>{title}</h1>
			{years.length > 0 && (
				<p class="year">
					{years.map((year, index) => (
						<>
							{index > 0 && "–"}
							<time datetime={year}>{year}</time>
						</>
					))}
				</p>
			)}
			<p class="description">{description}</p>
		</header>
		<section class="content prose">
			<slot />
		</section>
	</article>
</Layout>

<style>
	@layer components {
		article {
			inline-size: 100%;
			max-width: 56rem;
			margin-inline: auto;

			.content {
				margin-block-end: var(--t-space-18);
			}
		}

		header {
			margin-block-end: var(--t-space-6);
			font-weight: var(--t-font-weight-semibold);

			h1 {
				font-size: var(--t-font-size-xlarge);
				margin-block-end: var(--t-space-2);
			}

			.year {
				font-size: var(--t-font-size-small);
				color: color-mix(in oklch, currentColor 65%, transparent);
			}

			.description {
				margin-block: var(--t-space-6) var(--t-space-16);
				font-size: var(--t-font-size-medium);
				font-weight: var(--t-font-weight-medium);
				line-height: var(--t-font-line-height-tight);
				color: color-mix(in srgb, currentColor 85%, transparent);
			}
		}

		section {
			margin-block-end: var(--t-space-24);
		}
	}
</style>
