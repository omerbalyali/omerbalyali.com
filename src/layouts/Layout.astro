---
import Footer from "../components/app/Footer.astro";
import Head from "../components/app/Head.astro";
import Header from "../components/app/Header.astro";
import NavBar from "../components/app/NavBar.astro";
import type { PageMetadata } from "../lib/seo";

interface Props {
	lang?: string;
	metadata?: PageMetadata;
}

const { lang = "en", metadata } = Astro.props as Props;
const pageTransition = {
	forwards: {
		old: {
			name: "page-slide-out",
			duration: "160ms",
			easing: "cubic-bezier(0.2, 0, 0, 1)",
			fillMode: "both",
		},
		new: {
			name: "page-slide-in",
			duration: "220ms",
			easing: "cubic-bezier(0.2, 0, 0, 1)",
			fillMode: "both",
		},
	},
	backwards: {
		old: {
			name: "page-slide-out-reverse",
			duration: "160ms",
			easing: "cubic-bezier(0.2, 0, 0, 1)",
			fillMode: "both",
		},
		new: {
			name: "page-slide-in-reverse",
			duration: "220ms",
			easing: "cubic-bezier(0.2, 0, 0, 1)",
			fillMode: "both",
		},
	},
} as const;
---

<!doctype html>
<html lang={lang} data-theme="default">
	<head>
		<Head {...metadata} />
	</head>
	<body>
		<div class="layout">
			<Header />
			<main
				id="main-content"
				class="page app-container-padded"
				transition:name="page-content"
				transition:animate={pageTransition}>
				<slot />
			</main>
			<NavBar />
		</div>
		<Footer />
	</body>
</html>

<style>
	.layout {
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		background-color: var(--t-color-background-page);
	}

	.page {
		flex-grow: 1;
		position: relative;
		z-index: 1;
		padding-block: var(--t-space-16);
		background-color: var(--t-color-background-page);
		border-block: var(--t-border-thin) solid var(--t-color-border-primary);
	}

	@keyframes page-slide-out {
		to {
			transform: translateY(-0.5rem);
		}
	}

	@keyframes page-slide-in {
		from {
			transform: translateY(0.5rem);
		}
	}

	@keyframes page-slide-out-reverse {
		to {
			transform: translateY(0.5rem);
		}
	}

	@keyframes page-slide-in-reverse {
		from {
			transform: translateY(-0.5rem);
		}
	}
</style>
