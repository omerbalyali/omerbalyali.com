---
import Footer from "../components/app/Footer.astro";
import Head from "../components/app/Head.astro";
import Header from "../components/app/Header.astro";
import NavBar from "../components/app/NavBar.astro";
import type { PageMetadata } from "../lib/seo";

interface Props {
	lang?: string;
	metadata?: PageMetadata;
}

const { lang = "en", metadata } = Astro.props as Props;
---

<!doctype html>
<html lang={lang} data-theme="default">
	<head>
		<Head {...metadata} />
	</head>
	<body>
		<div class="layout">
			<Header />
			<main id="main-content" class="page app-container-padded">
				<slot />
			</main>
			<NavBar />
		</div>
		<Footer />
	</body>
</html>

<style>
	.layout {
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		background-color: var(--t-color-background-page);
	}

	.page {
		flex-grow: 1;
		position: relative;
		z-index: 1;
		padding-block: var(--t-space-18);
		background-color: var(--t-color-background-page);
		border-block: var(--t-border-thin) solid var(--t-color-border-primary);
	}
</style>
