---
import Footer from "../components/app/Footer.astro";
import Head from "../components/app/Head.astro";
import Header from "../components/app/Header.astro";
import NavBar from "../components/app/NavBar.astro";
import SkipLinks from "../components/app/SkipLinks.astro";
---

<!doctype html>
<html lang="en" data-theme="default">
	<head>
		<Head />
	</head>
	<body>
		<SkipLinks />
		<div class="layout">
			<Header />
			<div id="main-content" class="page app-container-padded">
				<slot />
			</div>
			<NavBar />
			<Footer />
		</div>
	</body>
</html>

<style>
	.layout {
		min-height: 100lvh;
		display: flex;
		flex-direction: column;
	}

	.page {
		flex: 1;
		padding-block: var(--t-space-6);
		background-color: var(--t-color-background-page);
	}
</style>
