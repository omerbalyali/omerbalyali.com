---
import Footer from "../components/app/Footer.astro";
import Head from "../components/app/Head.astro";
import Header from "../components/app/Header.astro";
import type { PageMetadata } from "../lib/seo";

interface Props {
	lang?: string;
	metadata?: PageMetadata;
}

const { lang = "en", metadata } = Astro.props as Props;
---

<!doctype html>
<html lang={lang} data-theme="default">
	<head>
		<Head {...metadata} />
	</head>
	<body>
		<Header />
		<main id="main-content">
			<slot />
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		display: flex;
		flex-direction: column;
		gap: var(--t-space-18);
		min-height: 100dvh;
		padding-block-start: var(--t-app-gutter);
		padding-inline: var(--t-app-gutter);
		background-color: var(--t-color-background-root);
	}
</style>
