{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "omerbalyali-com",
	"compatibility_date": "2026-04-20",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "404-page",
	},
	"routes": [
		{
			"pattern": "omerbalyali.com",
			"custom_domain": true,
		},
		{
			"pattern": "www.omerbalyali.com",
			"custom_domain": true,
		},
	],
	"observability": {
		"enabled": true,
	},
	// "upload_source_maps": true
}
