{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "omerbalyali-com",
	"compatibility_date": "2026-05-10",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "404-page",
	},
	"routes": [
		{
			"pattern": "omerbalyali.com",
			"custom_domain": true,
		},
		{
			"pattern": "www.omerbalyali.com",
			"custom_domain": true,
		},
	],
	"observability": {
		"enabled": true,
	},
	"env": {
		"preview": {
			"name": "preview-omerbalyali-com",
			"routes": [
				{
					"pattern": "preview.omerbalyali.com",
					"custom_domain": true,
				},
			],
		},
	},
}
