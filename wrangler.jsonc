{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "omerbalyali-com",
	"compatibility_date": "2026-09-21",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "404-page",
	},
	"routes": [
		{
			"pattern": "omerbalyali.com",
			"custom_domain": true,
		},
		{
			"pattern": "www.omerbalyali.com",
			"custom_domain": true,
		},
	],
	"observability": {
		"enabled": true,
	},
	"env": {
		// PR previews are versions of this Worker with per-PR aliases (see .github/workflows/preview.yml),
		// served at <alias>-preview-omerbalyali-com.<account subdomain>.workers.dev.
		"preview": {
			"name": "preview-omerbalyali-com",
			// Must stay empty: otherwise the top-level custom domains are inherited, and deploying
			// this environment would move omerbalyali.com to the preview Worker.
			"routes": [],
			"workers_dev": true,
			"preview_urls": true,
		},
	},
}
