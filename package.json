{
	"name": "omerbalyali.com",
	"private": true,
	"license": "UNLICENSED",
	"type": "module",
	"version": "0.0.1",
	"scripts": {
		"astro": "astro",
		"build": "astro check && astro build",
		"check": "astro check",
		"deploy": "pnpm run build && wrangler deploy",
		"dev": "astro dev",
		"dev:lan": "astro dev --host 0.0.0.0",
		"dev:lan:https": "LOCAL_HTTPS=true astro dev --host 0.0.0.0",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "astro check && prettier --check . && stylelint 'src/**/*.{css,astro}' --max-warnings 0",
		"lint:style": "stylelint 'src/**/*.{css,astro}' --max-warnings 0",
		"prepare": "lefthook install || true",
		"preview": "astro preview",
		"test": "astro build && vitest run && playwright test",
		"test:unit": "vitest run",
		"test:e2e": "pnpm run build && playwright test tests/e2e/pages.spec.ts",
		"test:a11y": "pnpm run build && playwright test tests/e2e/a11y.spec.ts"
	},
	"dependencies": {
		"@astrojs/mdx": "^7.0.8",
		"@astrojs/rss": "^4.0.19",
		"astro": "^7.3.3",
		"mdast-util-to-string": "^4.0.0",
		"reading-time": "^1.5.0",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-slug": "^6.0.0"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@astrojs/markdown-remark": "^7.3.1",
		"@astrojs/sitemap": "^3.7.4",
		"@axe-core/playwright": "^4.13.0",
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"@playwright/test": "^1.63.0",
		"@resvg/resvg-wasm": "^2.6.2",
		"@shikijs/transformers": "^4.4.3",
		"lefthook": "^2.1.14",
		"lightningcss": "^1.33.0",
		"postcss-html": "1.8.1",
		"prettier": "3.9.8",
		"prettier-plugin-astro": "0.14.1",
		"satori": "^0.26.0",
		"sharp": "^0.35.4",
		"stylelint": "17.15.0",
		"stylelint-config-html": "1.1.0",
		"stylelint-config-standard": "40.0.0",
		"typescript": "^6.0.3",
		"vitest": "^4.1.11",
		"wrangler": "4.135.0"
	},
	"engines": {
		"node": ">=24.21.0"
	},
	"packageManager": "pnpm@12.5.1"
}
