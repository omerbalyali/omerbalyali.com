{
	"name": "omerbalyali.com",
	"type": "module",
	"version": "0.0.1",
	"scripts": {
		"astro": "astro",
		"build": "wrangler types && astro check && astro build",
		"check": "astro check",
		"deploy": "wrangler types && astro build && wrangler deploy",
		"dev": "wrangler types && astro dev",
		"format": "prettier --write .",
		"lint:style": "stylelint 'src/**/*.{css,astro}' --max-warnings 0",
		"prepare": "lefthook install || true",
		"preview": "wrangler types && astro preview",
		"test": "pnpm exec astro build && pnpm test:unit && pnpm exec playwright test",
		"test:unit": "vitest run",
		"test:e2e": "playwright test tests/e2e/pages.spec.ts",
		"test:a11y": "playwright test tests/e2e/a11y.spec.ts"
	},
	"dependencies": {
		"@astrojs/cloudflare": "^13.5.0",
		"@astrojs/mdx": "^5.0.4",
		"astro": "^6.3.1",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-slug": "^6.0.0"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.9",
		"@astrojs/sitemap": "^3.7.2",
		"@axe-core/playwright": "^4.11.3",
		"@commitlint/cli": "^21.0.0",
		"@commitlint/config-conventional": "^21.0.0",
		"@playwright/test": "^1.59.1",
		"@resvg/resvg-wasm": "^2.6.2",
		"@shikijs/transformers": "^4.0.2",
		"lefthook": "^2.1.6",
		"lightningcss": "^1.32.0",
		"postcss-html": "1.8.1",
		"prettier": "3.8.3",
		"prettier-plugin-astro": "0.14.1",
		"satori": "^0.26.0",
		"stylelint": "17.11.0",
		"stylelint-config-html": "1.1.0",
		"stylelint-config-standard": "40.0.0",
		"typescript": "^6.0.3",
		"vitest": "^4.1.5",
		"wrangler": "4.90.0"
	},
	"engines": {
		"node": ">=24.0.0"
	},
	"packageManager": "pnpm@11.0.7"
}
