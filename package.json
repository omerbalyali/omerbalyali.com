{
	"name": "omerbalyali.com",
	"type": "module",
	"version": "0.0.1",
	"scripts": {
		"astro": "astro",
		"build": "astro check && astro build",
		"check": "astro check",
		"deploy": "astro build && wrangler deploy",
		"dev": "astro dev",
		"dev:lan": "astro dev --host 0.0.0.0",
		"dev:lan:https": "LOCAL_HTTPS=true astro dev --host 0.0.0.0",
		"format": "prettier --write .",
		"lint": "astro check && prettier --check . && stylelint 'src/**/*.{css,astro}' --max-warnings 0",
		"lint:style": "stylelint 'src/**/*.{css,astro}' --max-warnings 0",
		"prepare": "lefthook install || true",
		"preview": "astro preview",
		"test": "astro build && vitest run && playwright test",
		"test:unit": "vitest run",
		"test:e2e": "playwright test tests/e2e/pages.spec.ts",
		"test:a11y": "playwright test tests/e2e/a11y.spec.ts",
		"types:cf": "wrangler types"
	},
	"dependencies": {
		"@astrojs/cloudflare": "^13.5.2",
		"@astrojs/mdx": "^5.0.6",
		"@astrojs/rss": "^4.0.18",
		"astro": "^6.3.5",
		"mdast-util-to-string": "^4.0.0",
		"reading-time": "^1.5.0",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-slug": "^6.0.0"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.9",
		"@astrojs/sitemap": "^3.7.2",
		"@axe-core/playwright": "^4.11.3",
		"@commitlint/cli": "^21.0.1",
		"@commitlint/config-conventional": "^21.0.1",
		"@playwright/test": "^1.60.0",
		"@resvg/resvg-wasm": "^2.6.2",
		"@shikijs/transformers": "^4.1.0",
		"lefthook": "^2.1.7",
		"lightningcss": "^1.32.0",
		"postcss-html": "1.8.1",
		"prettier": "3.8.3",
		"prettier-plugin-astro": "0.14.1",
		"satori": "^0.26.0",
		"stylelint": "17.11.1",
		"stylelint-config-html": "1.1.0",
		"stylelint-config-standard": "40.0.0",
		"typescript": "^6.0.3",
		"vitest": "^4.1.6",
		"wrangler": "4.93.0"
	},
	"engines": {
		"node": ">=24.0.0"
	},
	"packageManager": "pnpm@11.1.3"
}
